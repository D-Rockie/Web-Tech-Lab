# Copy this file to .env and fill in your own values.
# .env is in .gitignore - never push your real connection string to GitHub.

# MongoDB Atlas connection string (Connect -> Drivers -> Node.js)
# Replace <db_password> with your database user's password.
ATLAS_URI=mongodb+srv://blogUser:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Name of the database the app should use
DB_NAME=blog

# Port the Express API listens on
PORT=5050
